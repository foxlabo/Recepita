// --- ADD to prisma/schema.prisma ---
// Receipt file metadata (local or Azure). Linkable to Expense.
model ReceiptFile {
  id        String   @id @default(uuid())
  storage   String   // 'local' | 'azure'
  path      String   // relative path (local) or blob name (azure)
  original  String
  mime      String?
  size      Int?
  createdAt DateTime @default(now())

  // link to expense after finalize
  expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?

  @@index([expenseId])
}

// (optional) To see linked files from Expense
// Add this to model Expense:
//   files ReceiptFile[]
