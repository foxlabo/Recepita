// Add this model into prisma/schema.prisma
model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  lastName       String?
  firstName      String?
  lastNameKana   String?
  firstNameKana  String?
  birthDate      DateTime?
  gender         String?
  phone          String?
  postalCode     String?
  prefecture     String?
  city           String?
  address1       String?
  address2       String?
  businessName   String?
  startDate      DateTime?
  occupation     String?
  invoiceNo      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id])
}
