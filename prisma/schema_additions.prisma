// === Recepita Bulk MVP Additions ===
model ExpenseFile {
  id         String   @id @default(cuid())
  expenseId  String?
  scanSetId  String?
  pageOrder  Int
  fileUrl    String
  type       String   // 'image'|'pdf'
  createdAt  DateTime @default(now())
  expense    Expense? @relation(fields: [expenseId], references: [id])
}

model ExpenseDraft {
  id         String   @id @default(cuid())
  scanSetId  String   @unique
  payload    Json
  status     String   // 'processing'|'ready'|'failed'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 参考: 既存に合わせて関連を付ける（ない場合は追加）
model Expense {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  partnerId String?
  total     Int
  taxMethod TaxMethod
  items     ExpenseItem[]
  files     ExpenseFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ExpenseItem {
  id         String   @id @default(cuid())
  expenseId  String
  name       String
  qty        Int      @default(1)
  unitPrice  Int
  taxRate    Int
  amount     Int
  expense    Expense  @relation(fields: [expenseId], references: [id])
}

enum TaxMethod {
  TRUNCATE
  ROUND
  CEIL
}
