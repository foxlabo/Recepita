// RecePita minimal working schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  expenses      Expense[]
  draftExpenses DraftExpense[]
  invoices      Invoice[]
  verificationTokens VerificationToken[]
  profile UserProfile?
  isEmailVerified Boolean @default(false)
  /// Embedded in the session JWT (`sv` claim). Incrementing it revokes every
  /// session issued for this user (password/email change, logout-all, deletion).
  sessionVersion  Int     @default(0)
}

enum VerificationTokenType {
  EMAIL_VERIFY // sign-up address confirmation
  EMAIL_CHANGE // confirmation of a new address from the settings screen
}

model VerificationToken {
  id        String                @id @default(cuid())
  /// SHA-256 (hex) of the token sent by e-mail; the raw token is never stored.
  tokenHash String                @unique
  type      VerificationTokenType
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Address the token was sent to (the new address for EMAIL_CHANGE).
  email     String
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Expense {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  date          DateTime
  amount        Int
  vendor        String
  category      String?
  memo          String?
  items         Json?
  subtotal      Int?
  tax           Int?
  total         Int?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineItems ExpenseItem[]

  @@index([userId, date])
}

model ExpenseItem {
  id        String  @id @default(cuid())
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  name      String
  qty       Int      @default(1)
  unitPrice Int      @default(0)
  taxRate   Int      @default(10)
  amount    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expenseId])
}


model DraftExpense {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  registeredDate DateTime @default(now())
  tradeDate      DateTime
  amount         Int
  vendor         String
  category       String?
  memo           String?
  itemsSummary   String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Invoice {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  issueDate    DateTime // ← DateTime 型
  client       String
  amount       Int
  memo         String?
  itemsSummary String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, issueDate])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  lastName      String?
  firstName     String?
  lastNameKana  String?
  firstNameKana String?
  birthDate     DateTime?
  gender        String?
  phone         String?
  postalCode    String?
  prefecture    String?
  city          String?
  address1      String?
  address2      String?
  businessName  String?
  startDate     DateTime?
  occupation    String?
  invoiceNo     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 外部キー側（userId が一意 → 1:1）
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


