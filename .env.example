DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recepita"
JWT_SECRET="replace-with-a-long-random-string"

# App URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Local storage
STORAGE_LOCAL_DIR=".storage"
UPLOAD_DIR="uploads"
FILE_STORAGE_DIR="./.uploads"

# Optional session/app settings
SESSION_TTL_DAYS=7
DEFAULT_USER_ID=""

# Optional OCR / Azure Document Intelligence
OCR_PROVIDER=""
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION="2023-07-31"
AZURE_DI_MODEL="prebuilt-receipt"
DI_MOCK_MODE=false

# Optional AI post-processing
AI_PROVIDER="openai"
USE_AI=0
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_OCR_CATEGORY_MODEL="gpt-4.1-mini"

# Optional mail (Azure Communication Services)
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_SENDER=""

# Optional SMTP mailer
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"
