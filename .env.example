# --- Required -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recepita"
# Session JWT signing key (HS256). Use a long random value (32+ chars).
JWT_SECRET="replace-with-a-long-random-string"
# Public base URL; used to build links in e-mails. Required in production.
APP_URL="http://localhost:3000"

# --- Mail (Azure Communication Services) -----------------------------------
# Required in production. In development, if unset, mails (including the
# verification link) are printed to the server console instead of sent.
AZURE_COMMUNICATION_CONNECTION_STRING=""
AZURE_COMMUNICATION_SENDER=""

# Development only: also return the verification link in API responses
# (ignored when NODE_ENV=production).
SHOW_DEV_VERIFICATION_LINK=0

# --- Optional: OCR (Azure Document Intelligence) ---------------------------
OCR_PROVIDER=""
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION="2023-07-31"

# --- Optional: AI expense-category suggestion (OpenAI) ---------------------
OPENAI_API_KEY=""
OPENAI_OCR_CATEGORY_MODEL="gpt-4.1-mini"
