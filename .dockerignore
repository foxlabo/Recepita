# Build context = repository root (see recepita_azure_container_deploy/Dockerfile)

# VCS / editor
.git
.github
.vscode

# Secrets: never send env files or keys into the build context
.env*
*.pem
*.key
recepita-*.json

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
lib/generated
tsconfig.tsbuildinfo
dist
out
coverage

# Logs and local runtime data
*.log
npm-debug.log*
.storage
uploads
.uploads

# Misc
source.zip
docker-compose.yml
*Zone.Identifier*
